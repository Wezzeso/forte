      "type": "string"
    },
    "event_type_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Event Type Id",
      "type": "string"
    },
    "start_sec": {
      "minimum": 0,
      "title": "Start Sec",
      "type": "number"
    },
    "end_sec": {
      "minimum": 0,
      "title": "End Sec",
      "type": "number"
    },
    "supporting_facts": {
      "items": {
        "$ref": "#/$defs/FactDecision"
