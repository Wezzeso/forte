{
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "status": {
      "default": "processing",
      "enum": [
        "processing",
        "done",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "stage": {
      "default": "queued",
      "enum": [
        "queued",
        "claimed",
        "decoding",
        "screening",
        "refining",
        "assembling",
        "done",
        "failed"
      ],
      "title": "Stage",
      "type": "string"
    },
    "accepted_at": {
      "format": "date-time",
      "title": "Accepted At",
      "type": "string"
    },
    "deadline_at": {
      "format": "date-time",
      "title": "Deadline At",
      "type": "string"
    },
    "owned_path": {
      "title": "Owned Path",
      "type": "string"
    },
    "content_hash": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "lease_owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Owner"
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires At"
    },
    "attempt": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "fencing_version": {
      "default": 0,
      "minimum": 0,
      "title": "Fencing Version",
      "type": "integer"
    },
    "result_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Path"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "error_detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Detail"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    }
  },
  "required": [
    "job_id",
    "accepted_at",
    "deadline_at",
    "owned_path"
  ],
  "title": "JobRecord",
  "type": "object"
}
