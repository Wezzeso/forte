# A Dockerfile-specific allowlist overrides the CPU image's exclusion of training/.
# No videos, labels, annotations, checkpoints, local environments, or secrets enter.
**
!training/
training/**
!training/*.py
!training/temporal/
training/temporal/**
!training/temporal/*.py
!training/temporal/fact-axis.v1.json
!training/temporal/w2-protocol.v1.json
!training/requirements-addons.lock
!training/runtime-lock.json
!training/e1.example.json
!src/
src/**
!src/forte/
src/forte/**
!src/forte/*.py
!src/forte/**/*.py
!scripts/
scripts/**
!scripts/audit_data.py
!scripts/build_reviewed_split.py
!scripts/exposure_registry.py
!scripts/split_gate.py
!scripts/build_automated_split.py
!evaluation/
evaluation/**
!evaluation/*.py
!models/
models/**
!models/manifest.json
!annotations/
annotations/**
!annotations/taxonomy.v1.json
!configs/
configs/**
!configs/decision/
configs/decision/**
!configs/decision/default.json
**/__pycache__/
**/*.pyc
# Keep private mounts and generated artifacts out of all selected source roots.
**/private
**/secrets
**/runs
**/checkpoints
**/weights
**/*.mov
**/*.MOV
**/*.mp4
**/*.webm
**/*.jsonl
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.gguf
**/.env
**/*.local.env
