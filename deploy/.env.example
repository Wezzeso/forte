# Paths are resolved from deploy/ when using the documented compose command.
FORTE_SECRETS_DIR=./secrets
FORTE_APP_IMAGE=forte-review:local
FORTE_MODEL_BASE_URL=http://model:8000/v1
FORTE_BIND_HOST=127.0.0.1
FORTE_HTTP_PORT=8080
FORTE_HTTPS_PORT=8443
FORTE_SITE_ADDRESS=:80
FORTE_MAX_UPLOAD_BYTES=268435456
FORTE_MAX_INFLIGHT_PER_JOB=1
FORTE_COMPACT_FRAME_IDS=false
FORTE_CONCISE_OBSERVATIONS=false
FORTE_STAGED_SCREENING=false
# Leave empty for same-origin deployments; allow only the exact team frontend
# origin when the operator selects the separate trusted team API gateway.
FORTE_CORS_ALLOWED_ORIGINS=
FORTE_PUBLIC_API_BASE_URL=
FORTE_PROXY_MAX_BODY=272MB
# Set only when the operator knows uploads are within the organizer's bank cash
# workstation case. Empty remains the generic fail-closed default.
FORTE_TRUSTED_SCENE_CONTEXT=
# Production: set a real DNS name, bind 0.0.0.0, and use host ports 80 and 443.
# FORTE_SITE_ADDRESS=review.example.org
# FORTE_MODEL_SNAPSHOT=/srv/forte/models/Qwen3-VL-8B-Instruct
# FORTE_INFERENCE_GPU_ID=0

# Fast profile: compose.yaml + compose.fast.yaml. Run bootstrap only on an
# already-authorized Linux GPU host. Choose a reviewed immutable HF revision;
# bootstrap rejects an empty pin and never invents one or silently uses main.
FORTE_FAST_MODEL_DIR=/data/models/Qwen3-VL-30B-A3B-Instruct
FORTE_FAST_MODEL_REPO=Qwen/Qwen3-VL-30B-A3B-Instruct
FORTE_FAST_MODEL_REVISION=
FORTE_FAST_VLLM_SOURCE_IMAGE=vllm/vllm-openai:v0.31.0-cu129
FORTE_MODEL_IMAGE=forte-model:vllm-0.31.0
FORTE_FAST_READY_TIMEOUT_SECONDS=900
# The fast overlay fixes 4 jobs and exactly one worker. Extra jobs queue with
# the existing 285-second deadline, measured from upload request start.
