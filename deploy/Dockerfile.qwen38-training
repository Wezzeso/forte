# syntax=docker/dockerfile:1.7
# Dedicated candidate runtime; the existing serving and feature images are kept.
# Before building, verify this local parent's immutable image ID against the lock.
FROM forte-features:cu129-w1
USER root
WORKDIR /app
LABEL forte.qwen38.expected-parent-image="sha256:1bcad5aaa9c13266e1adc9f9ce302e29aaaeacccbe1354a84cb984e611977b27"
COPY deploy/requirements-qwen38.lock /opt/forte-locks/qwen38-addons.lock
COPY deploy/qwen38-training-runtime-lock.json /opt/forte-locks/qwen38-runtime.json
COPY deploy/qwen38_runtime_check.py /opt/forte-locks/qwen38-check.py
# Only the hash-verified public wheel is added. Core Torch/Transformers/PEFT,
# CUDA libraries and the feature environment are inherited without resolution.
RUN env -u UV_OVERRIDE uv pip install --python /opt/forte-features/bin/python \
    --no-deps --only-binary :all: --require-hashes \
    -r /opt/forte-locks/qwen38-addons.lock \
    && /opt/forte-features/bin/python /opt/forte-locks/qwen38-check.py \
       --lock /opt/forte-locks/qwen38-runtime.json
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 \
    WANDB_DISABLED=true TOKENIZERS_PARALLELISM=false \
    CUBLAS_WORKSPACE_CONFIG=:4096:8
ENTRYPOINT ["/opt/forte-features/bin/python"]
CMD ["/opt/forte-locks/qwen38-check.py", "--lock", "/opt/forte-locks/qwen38-runtime.json"]
